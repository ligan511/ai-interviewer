# AI Service 环境变量配置示例
# 复制本文件为 .env 并填入真实值
# SiliconFlow 注册地址：https://siliconflow.cn（手机号注册，送免费额度）

# ── SiliconFlow API Key（必需）──────────────────────────────────
# 登录后在控制台 → API密钥 页面创建
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# ── LLM 对话模型（出题 / 评分 / 生成报告）──────────────────────
LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
# 免费模型推荐：
#   tencent/Hunyuan-MT-7B         — 免费，快速，中文质量好
#   Z-ai/GLM-5.2                  — 免费，能力强
#   deepseek-ai/DeepSeek-V4-Flash — 免费（限时段）
MODEL_NAME=tencent/Hunyuan-MT-7B

# ── Embedding 模型（RAG 知识库检索）─────────────────────────────
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# 免费模型：
#   BAAI/bge-m3                   — 免费，多语言 Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# ── 语音转文字（P1 功能，可选）──────────────────────────────────
# DASHSCOPE_API_KEY=                               # 阿里云 DashScope Key（留空则使用文字回答）
# VOICE_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra    # 免费 ASR 模型
DASHSCOPE_API_KEY=

# ── 服务端口 ────────────────────────────────────────────────────
AI_SERVICE_PORT=8001
