# AI Service 环境变量配置示例
# 复制本文件为 .env 并填入真实值

# ── Agnes AI（主对话模型，出题 / 评分 / 生成报告）────────────────
# 注册地址：https://platform.agnes-ai.com/settings/apiKeys
# 文档：https://wiki.agnes-ai.com
AGNES_API_KEY=your-agnes-api-key-here
LLM_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
MODEL_NAME=agnes-2.5-flash

# ── Embedding（RAG 知识库检索）────────────────────────────────────
# Agnes 暂未提供 Embedding API，使用 SiliconFlow 免费版替代
# 注册地址：https://siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# ── 语音转文字（P1 功能，可选）──────────────────────────────────
DASHSCOPE_API_KEY=

# ── 服务端口 ────────────────────────────────────────────────────
AI_SERVICE_PORT=8001
